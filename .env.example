# Copie para .env e preencha. O .env esta no .gitignore e nunca vai para o repositorio.

# Token da API IronPay (painel > configuracoes de API).
# Vai na query string das chamadas, entao usar SOMENTE no servidor — nunca no navegador.
IRONPAY_API_TOKEN=

# URL que recebe o postback da IronPay. Preencher quando o backend estiver publicado.
IRONPAY_POSTBACK_URL=
